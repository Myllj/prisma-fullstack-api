# ===== 服务配置 =====
PORT=3000

# ===== JWT 配置 =====
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# ===== 数据库配置（请修改为实际值）=====
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=prisma_demo
DATABASE_CHARSET=utf8mb4

# ===== 数据库连接串（Prisma migrate 使用）=====
DATABASE_URL="mysql://root:your_password@127.0.0.1:3306/prisma_demo"
