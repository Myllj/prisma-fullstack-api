{
  "swagger": "2.0",
  "info": {
    "title": "Prisma Fullstack API",
    "description": "全栈项目接口文档 - 包含用户认证、用户管理、文章管理三大模块",
    "version": "1.0.0",
    "contact": {
      "name": "API Support"
    }
  },
  "host": "localhost:3000",
  "basePath": "/api",
  "schemes": ["http", "https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],

  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "JWT Token: Bearer {token}"
    }
  },

  "definitions": {
    "UserWithoutPassword": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "description": "用户ID" },
        "name": { "type": "string", "description": "用户名" },
        "email": { "type": "string", "description": "邮箱" },
        "role": { "type": "string", "enum": ["USER", "ADMIN"], "description": "角色" },
        "createdAt": { "type": "string", "format": "date-time", "description": "创建时间" }
      }
    },
    "UserWithPassword": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "description": "用户ID" },
        "name": { "type": "string", "description": "用户名" },
        "email": { "type": "string", "description": "邮箱" },
        "password": { "type": "string", "description": "加密密码" },
        "role": { "type": "string", "enum": ["USER", "ADMIN"], "description": "角色" },
        "createdAt": { "type": "string", "format": "date-time", "description": "创建时间" }
      }
    },
    "Post": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "description": "文章ID" },
        "title": { "type": "string", "description": "文章标题" },
        "content": { "type": "string", "description": "文章内容" },
        "userId": { "type": "integer", "description": "作者用户ID" },
        "user": {
          "type": "object",
          "description": "作者信息（不包含密码）",
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": "string" },
            "email": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "创建时间" }
      }
    },
    "LoginRequest": {
      "type": "object",
      "required": ["email", "password"],
      "properties": {
        "email": { "type": "string", "format": "email", "description": "用户邮箱" },
        "password": { "type": "string", "description": "用户密码" }
      }
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "user": { "$ref": "#/definitions/UserWithoutPassword" },
        "token": { "type": "string", "description": "JWT Token" }
      }
    },
    "CreateUserRequest": {
      "type": "object",
      "required": ["name", "email", "password"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 50, "description": "用户名" },
        "email": { "type": "string", "format": "email", "description": "邮箱" },
        "password": { "type": "string", "minLength": 6, "maxLength": 50, "description": "密码" }
      }
    },
    "UpdateUserRequest": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 50, "description": "用户名（可选）" },
        "email": { "type": "string", "format": "email", "description": "邮箱（可选）" },
        "password": { "type": "string", "minLength": 6, "maxLength": 50, "description": "密码（可选）" }
      }
    },
    "CreatePostRequest": {
      "type": "object",
      "required": ["title", "content"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "文章标题" },
        "content": { "type": "string", "description": "文章内容" }
      }
    },
    "UpdatePostRequest": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "文章标题（可选）" },
        "content": { "type": "string", "description": "文章内容（可选）" }
      }
    },
    "PostListResponse": {
      "type": "object",
      "properties": {
        "list": {
          "type": "array",
          "items": { "$ref": "#/definitions/Post" }
        },
        "total": { "type": "integer", "description": "总记录数" },
        "page": { "type": "integer", "description": "当前页码" },
        "pageSize": { "type": "integer", "description": "每页条数" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "description": "错误信息" }
      }
    }
  },

  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["认证 Auth"],
        "summary": "用户登录",
        "description": "使用邮箱和密码登录，返回用户信息和 JWT Token",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/LoginRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "登录成功",
            "schema": { "$ref": "#/definitions/LoginResponse" }
          },
          "401": {
            "description": "邮箱或密码错误",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },

    "/user/profile": {
      "get": {
        "tags": ["用户 User"],
        "summary": "获取当前用户信息",
        "description": "获取当前登录用户的详细信息，包含关联的文章列表",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "allOf": [
                { "$ref": "#/definitions/UserWithoutPassword" },
                {
                  "type": "object",
                  "properties": {
                    "posts": {
                      "type": "array",
                      "items": { "$ref": "#/definitions/Post" }
                    }
                  }
                }
              ]
            }
          },
          "401": {
            "description": "未登录或 Token 无效",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },

    "/user/list": {
      "get": {
        "tags": ["用户 User"],
        "summary": "获取用户列表",
        "description": "获取所有注册用户列表",
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/UserWithPassword" }
            }
          }
        }
      }
    },

    "/user/{id}": {
      "get": {
        "tags": ["用户 User"],
        "summary": "获取用户详情",
        "description": "根据ID获取指定用户的详细信息",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "用户ID"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/UserWithPassword" }
          },
          "404": {
            "description": "用户不存在",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },

    "/user/create": {
      "post": {
        "tags": ["用户 User"],
        "summary": "创建用户（注册）",
        "description": "创建新用户，邮箱不能重复",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CreateUserRequest" }
          }
        ],
        "responses": {
          "201": {
            "description": "创建成功",
            "schema": { "$ref": "#/definitions/UserWithPassword" }
          },
          "409": {
            "description": "邮箱已注册",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },

    "/user/{id}/update": {
      "put": {
        "tags": ["用户 User"],
        "summary": "更新用户信息",
        "description": "根据ID更新用户信息，所有字段均为可选",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "用户ID"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/UpdateUserRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功",
            "schema": { "$ref": "#/definitions/UserWithPassword" }
          },
          "404": {
            "description": "用户不存在",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },

    "/user/{id}/delete": {
      "delete": {
        "tags": ["用户 User"],
        "summary": "删除用户",
        "description": "根据ID删除用户。如果用户有关联的文章，需先删除文章",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "用户ID"
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功"
          },
          "400": {
            "description": "用户存在关联文章，无法删除",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "404": {
            "description": "用户不存在",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },

    "/post/list": {
      "get": {
        "tags": ["文章 Post"],
        "summary": "获取文章列表（分页）",
        "description": "分页获取文章列表，支持按标题模糊搜索",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "type": "integer",
            "default": 1,
            "description": "页码"
          },
          {
            "in": "query",
            "name": "pageSize",
            "type": "integer",
            "maximum": 100,
            "default": 10,
            "description": "每页条数（最大100）"
          },
          {
            "in": "query",
            "name": "keyword",
            "type": "string",
            "description": "搜索关键词（模糊匹配标题）"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/PostListResponse" }
          },
          "401": {
            "description": "未登录",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },

    "/post/{id}": {
      "get": {
        "tags": ["文章 Post"],
        "summary": "获取文章详情",
        "description": "根据ID获取文章详细信息",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "文章ID"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/Post" }
          },
          "401": {
            "description": "未登录",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "404": {
            "description": "文章不存在",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },

    "/post/create": {
      "post": {
        "tags": ["文章 Post"],
        "summary": "创建文章",
        "description": "创建新文章，userId 自动从 JWT Token 获取",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CreatePostRequest" }
          }
        ],
        "responses": {
          "201": {
            "description": "创建成功",
            "schema": { "$ref": "#/definitions/Post" }
          },
          "401": {
            "description": "未登录",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },

    "/post/{id}/update": {
      "put": {
        "tags": ["文章 Post"],
        "summary": "更新文章",
        "description": "更新指定文章（仅文章作者可操作），所有字段可选",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "文章ID"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/UpdatePostRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功",
            "schema": { "$ref": "#/definitions/Post" }
          },
          "401": {
            "description": "未登录",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "403": {
            "description": "无权修改他人文章",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "404": {
            "description": "文章不存在",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },

    "/post/{id}/delete": {
      "delete": {
        "tags": ["文章 Post"],
        "summary": "删除文章",
        "description": "删除指定文章（仅文章作者可操作）",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "文章ID"
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功"
          },
          "401": {
            "description": "未登录",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "403": {
            "description": "无权删除他人文章",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "404": {
            "description": "文章不存在",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    }

  }
}
